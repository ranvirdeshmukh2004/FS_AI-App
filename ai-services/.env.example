# ---- Qdrant ----
# Managed cluster (Qdrant Cloud free tier) — preferred when deploying:
# QDRANT_URL=https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Local Docker fallback (used when QDRANT_URL is unset):
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
COLLECTION_NAME=chat_memory

# ---- Security ----
# Comma-separated allowed browser origins. Set this to your frontend URL in
# production; "*" is for local development only.
CORS_ORIGINS=*

# The Python tool runs model-authored code in a best-effort sandbox.
# Leave false on any public deployment.
ENABLE_PYTHON_TOOL=false
