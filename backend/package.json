{
  "name": "fs-ai-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev:local": "cross-env DATABASE_URL=file:./prisma/dev.db AI_SERVICES_URL=http://127.0.0.1:8001 OLLAMA_BASE_URL=http://localhost:11434 tsx watch src/index.ts",
    "db:local": "cross-env DATABASE_URL=file:./prisma/dev.db prisma db push --schema=prisma/schema.local.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "eventsource-parser": "^3.0.1",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
