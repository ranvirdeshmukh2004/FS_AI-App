# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
# Local Docker:
DATABASE_URL=postgresql://postgres:localdev123@localhost:5432/fs_ai_chat
# Neon (free tier) — note sslmode=require:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Services ----
AI_SERVICES_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434

# ---- Deployment mode ----
# true  = bring-your-own-key. Visitors send their own provider key with each
#         request; nothing is stored server-side. Use this for any public URL.
# false = keys are stored encrypted in the database. Local/self-hosted only —
#         on a public URL anyone who finds it can read and spend them.
DEMO_MODE=false

# ---- Security ----
# Allowed browser origins, comma-separated. "*" is development only.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=*

# Required when DEMO_MODE=false. Exactly 64 hex characters.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here

# ---- Limits ----
# Uploads are buffered in memory; keep this well under the container's RAM.
MAX_UPLOAD_MB=10
