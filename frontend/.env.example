# Base URL of the backend API.
#
# Leave this UNSET for local development and Docker: the Vite dev server
# proxies /api to localhost:4000, and nginx does the same in the container,
# so same-origin requests just work.
#
# Set it when the frontend and API are hosted separately — for example a
# Vercel frontend talking to a Render backend. Build-time only, so changing
# it means redeploying the frontend.
#
# VITE_API_URL=https://fs-ai-backend.onrender.com
